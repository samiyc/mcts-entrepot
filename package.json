{
  "name": "mcts-entrepot",
  "version": "0.1.0",
  "private": true,
  "description": "Des robots d'entrepôt et un cariste humain : affectation par MCTS, chemins par A* avec réservations.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc -p .",
    "check": "npm run lint && npm run types && npm test",
    "compare": "node scripts/compare.js",
    "line": "node scripts/line-compare.js",
    "plant": "node scripts/plant-compare.js",
    "bench": "node scripts/search-bench.js",
    "page": "node node_modules/mcts-commun/bin/serve.js 4802",
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "node scripts/changelog.js",
    "night": "node scripts/night.js"
  },
  "author": "Sami",
  "license": "UNLICENSED",
  "dependencies": {
    "mcts-commun": "file:../mcts-commun"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  }
}
